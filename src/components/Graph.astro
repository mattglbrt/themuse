---
// Global graph (no focus) or one-hop local graph (focus = slug).
// The canvas is drawn client-side from /graph.json; the list underneath is
// the no-JS / screen-reader fallback with the same nodes.
import { getVault, toGraphJson } from '../lib/vault.mjs';
import { NODE_TYPES } from '../lib/types.mjs';

interface Props {
  focus?: string;
  class?: string;
}
const { focus, class: className } = Astro.props;
const graph = toGraphJson(getVault());
const inView = focus
  ? new Set([focus, ...graph.edges.flatMap((e) => (e.source === focus ? [e.target] : e.target === focus ? [e.source] : []))])
  : null;
const shown = graph.nodes.filter((n) => !inView || inView.has(n.slug));
const types = Object.entries(NODE_TYPES).filter(([t]) => shown.some((n) => n.type === t));
---

<div class:list={['graph', className]} data-graph data-focus={focus}>
  <canvas aria-hidden="true"></canvas>
  <ul class="legend">
    {types.map(([t, info]) => <li><span class="swatch" style={`background:${info.color}`}></span>{info.label}</li>)}
  </ul>
  <ul class="sr-only">
    {shown.map((n) => <li><a href={`/${n.slug}/`}>{n.title}</a></li>)}
  </ul>
</div>

<script>
  import { mountGraphs } from '../scripts/graph.js';
  mountGraphs();
</script>

<style>
  .graph {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 16rem;
    overflow: hidden;
  }
  canvas {
    position: absolute;
    inset: 0;
    /* Pin the display size; the backing store is width × devicePixelRatio. */
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }
  .legend {
    position: absolute;
    left: 0.75rem;
    bottom: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--muted);
    pointer-events: none;
  }
  .swatch {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.35rem;
    border-radius: 50%;
  }
</style>
